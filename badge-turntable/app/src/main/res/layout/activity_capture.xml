<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape: remote control's address and code centred across the top (clear of the camera
  privacy indicator in the corner), the whole 4:3 frame (as the stills are) in the middle, a
  status line across the bottom, and the ring reading and buttons in the columns either side.
  Nothing covers the picture or the ring, and nothing moves as the reading changes.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/remote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/badge_amber"
            android:visibility="invisible"
            tools:text="badge-turntable.local · 192.168.10.116:8737 · code 729 211"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Capturing Side (90°) on the move…" />

    <FrameLayout
        android:id="@+id/preview_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/status"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <org.snurkle.badgeturntable.ui.FramingOverlay
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Left: framing and the camera -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@id/status"
        app:layout_constraintEnd_toStartOf="@id/preview_frame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- The ring reading: two fixed lines, so nothing shifts as it changes -->
        <TextView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lines="2"
            android:textColor="#CCFFFFFF"
            tools:text="Ring 204.4°\n10 tags · front +0.3°" />

        <Button
            android:id="@+id/set_front"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_front" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/lens"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Lens: Main"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/zoom_out"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/zoom_out"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/zoom_minus" />

            <!-- The zoom; tap to go back to 1× -->
            <Button
                android:id="@+id/zoom_reset"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1.4"
                android:contentDescription="@string/zoom_reset"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                tools:text="1.0×" />

            <Button
                android:id="@+id/zoom_in"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/zoom_in"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/zoom_plus" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ev_minus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/ev_minus" />

            <Button
                android:id="@+id/ev_plus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="@string/ev_plus" />
        </LinearLayout>

        <Button
            android:id="@+id/wb"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="WB: auto" />
    </LinearLayout>

    <!-- Right: turntable mode and the actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@id/status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/preview_frame"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- The open session (where captures go); tap for the session picker -->
        <Button
            android:id="@+id/target"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            tools:text="Badge: Mk9" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/auto_turntable"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@android:color/white" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/guides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/guides"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@android:color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/calibrate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibrate" />

        <!-- Extra shot, or Stop while a job runs -->
        <Button
            android:id="@+id/extra"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/extra_shot" />

        <!-- Capture, or Ready when manual mode is waiting for the table -->
        <Button
            android:id="@+id/capture"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:text="@string/capture" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
